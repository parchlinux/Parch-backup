<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-pbar">
    <comment>Parch Backup Archive</comment>
    <glob pattern="*.pbar"/>
    <magic priority="50">
      <match value="PBAR" type="string" offset="0"/>
    </magic>
    <icon name="com.parchlinux.backup"/>
  </mime-type>
</mime-info>
